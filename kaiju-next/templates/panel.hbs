<section class="kaiju-app" aria-label="Painel de vínculos Kaiju">
  <aside class="kaiju-sidebar">
    <div class="kaiju-brand"><i class="fa-solid fa-dragon" aria-hidden="true"></i><div><strong>KAIJU</strong><small>PROGRAMA DE VÍNCULOS</small></div></div>
    <div class="kaiju-list-heading"><span>Portadores</span><span>{{count}}</span></div>
    <label class="kaiju-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-search placeholder="Buscar portador" aria-label="Buscar portador" value="{{search}}"></label>
    <nav class="kaiju-carriers" aria-label="Portadores">
      {{#each carriers}}<button type="button" class="kaiju-carrier {{#if selected}}is-selected{{/if}} {{#if pending}}has-draft{{/if}}" data-record="{{id}}" {{#if selected}}aria-current="true"{{/if}}><span class="kaiju-avatar" aria-hidden="true">{{#if displayPortrait}}<img src="{{displayPortrait}}" alt="" loading="lazy">{{else}}{{initials}}{{/if}}</span><span><strong>{{name}}</strong><small>{{subtitle}}</small></span><span class="kaiju-draft-marker" {{#unless pending}}hidden{{/unless}} title="Alterações não salvas" aria-label="Alterações não salvas"></span><i class="fa-solid {{#if shared}}fa-eye{{else}}fa-lock{{/if}}" title="{{#if shared}}Compartilhado{{else}}Restrito{{/if}}" aria-label="{{#if shared}}Compartilhado{{else}}Restrito{{/if}}"></i></button>{{/each}}
      <p class="kaiju-no-results" hidden>Nenhum portador encontrado.</p>
    </nav>
    {{#if isGM}}<button type="button" class="kaiju-button kaiju-new" data-command="new"><i class="fa-solid fa-plus" aria-hidden="true"></i>Novo portador</button>{{/if}}
    <div class="kaiju-sidebar-footer"><span class="kaiju-dot"></span>{{#if isGM}}Visão do mestre{{else}}Visão do jogador{{/if}}<small>K-03 / CONSOLE BIOSSIMBIÓTICO</small></div>
  </aside>
  <main class="kaiju-main"><div class="kaiju-program-bar"><span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> LANCERS <b>//</b> PROGRAMA K-03</span><span><i class="fa-solid fa-lock" aria-hidden="true"></i> DOSSIÊ CLASSIFICADO</span></div>
    <div class="kaiju-compact-picker"><label>Portador<select data-record-select>{{#each carriers}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{#if isGM}}<button type="button" data-command="new" aria-label="Novo portador"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}</div>
    {{#if carrier}}
    <header class="kaiju-record-header"><div><div class="kaiju-eyebrow">ARQUIVO BIOSSIMBIÓTICO <span aria-hidden="true">/</span> {{carrier.code}}</div><h1>{{carrier.name}}</h1><p>{{carrier.designation}}</p></div><span class="kaiju-access"><i class="fa-solid {{#if carrier.shared}}fa-eye{{else}}fa-lock{{/if}}" aria-hidden="true"></i>{{#if carrier.shared}}Compartilhado{{else}}Restrito ao mestre{{/if}}</span></header>
    <div class="kaiju-tabs" role="tablist" aria-label="Seções do vínculo"><span class="kaiju-tab-indicator" aria-hidden="true"></span>{{#each tabs}}<button type="button" role="tab" id="{{../instance}}-tab-{{id}}" aria-controls="{{../instance}}-panel-{{id}}" aria-selected="{{active}}" tabindex="{{#if active}}0{{else}}-1{{/if}}" data-tab="{{id}}"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i>{{label}}</button>{{/each}}</div>
    <div class="kaiju-body" role="tabpanel" id="{{instance}}-panel-{{activeTab}}" aria-labelledby="{{instance}}-tab-{{activeTab}}" tabindex="0">
      {{#if overview}}
      <div class="kaiju-dossier">
        <aside class="kaiju-subject" aria-label="Dossiê visual do portador">
          <div class="kaiju-section-title"><span><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> IDENTIFICAÇÃO DO PORTADOR</span><b>01</b></div>
          <div class="kaiju-portrait">
            <div class="kaiju-photo {{#unless carrier.displayPortrait}}has-no-photo{{/unless}}">
              <div class="kaiju-photo-placeholder"><i class="fa-solid fa-user-astronaut" aria-hidden="true"></i><span>RETRATO NÃO CADASTRADO</span></div>
              {{#if carrier.displayPortrait}}<img src="{{carrier.displayPortrait}}" alt="Retrato de {{carrier.name}}" data-portrait-image>{{/if}}
              <div class="kaiju-scanner" aria-hidden="true">
                <div class="kaiju-scan-pass"><svg class="kaiju-scan-mesh" viewBox="0 0 240 70" preserveAspectRatio="none"><path d="M0 0H240M0 23H240M0 46H240M0 69H240M0 0V70M40 0V70M80 0V70M120 0V70M160 0V70M200 0V70M240 0V70M0 0 80 70 160 0 240 70M0 70 80 0 160 70 240 0"/></svg><i class="kaiju-scan-beam"></i><i class="kaiju-scan-tip left"></i><i class="kaiju-scan-tip right"></i></div>
                <div class="kaiju-scan-acquisition"></div>
                <div class="kaiju-scan-orbit"><svg class="kaiju-scan-orbit-outer" viewBox="0 0 64 64"><circle cx="32" cy="32" r="29"/><path d="M32 0V8M32 56V64M0 32H8M56 32H64"/></svg><svg class="kaiju-scan-orbit-inner" viewBox="0 0 64 64"><circle cx="32" cy="32" r="21"/><path d="m25 32 5 5 10-12"/></svg></div>
                <div class="kaiju-scan-samples"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                <div class="kaiju-scan-confirm"></div>
              </div>
              <div class="kaiju-photo-corners" aria-hidden="true"></div>
            </div>
            <div class="kaiju-photo-caption"><span>PORTADOR KAIJU</span><strong>{{carrier.name}}</strong><small>{{carrier.designation}}</small></div>
          </div>
          <div class="kaiju-subject-data"><div><span>ACESSO AO ARQUIVO</span><strong><i class="fa-solid {{#if carrier.shared}}fa-eye{{else}}fa-lock{{/if}}" aria-hidden="true"></i> {{#if carrier.shared}}Compartilhado{{else}}Restrito ao mestre{{/if}}</strong></div><div><span>PROTOCOLO DE LEITURA</span><strong>Três eixos independentes</strong></div></div>
          <div class="kaiju-subject-ranks">{{#each axes}}<div style="{{theme}}"><i class="fa-solid fa-{{stage.icon}}" aria-hidden="true"></i><span>{{short}}<small>{{stage.roman}} / VI</small></span><b>{{value}}<small>%</small></b></div>{{/each}}</div>
          {{#if isGM}}<button class="kaiju-image-shortcut" type="button" data-tab="notes"><i class="fa-solid fa-image" aria-hidden="true"></i> Configurar retrato <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>{{/if}}
        </aside>
        <div class="kaiju-readout" data-readout><div class="kaiju-section-title"><span><i class="fa-solid fa-wave-square" aria-hidden="true"></i> TELEMETRIA DO VÍNCULO</span><b>03 CANAIS</b></div>{{{readout}}}</div>
      </div>
      {{/if}}
      {{#if isGM}}{{#if edit}}
      <div class="kaiju-editor-intro"><h2>Controle do vínculo</h2><p>Ajuste os três canais e salve para atualizar a leitura dos jogadores.</p></div>
      <div class="kaiju-overview">
        <section class="kaiju-vectors" aria-labelledby="{{instance}}-axes"><h2 class="kaiju-sr-only" id="{{instance}}-axes">Os três eixos</h2>
          {{#each axes}}<article class="kaiju-axis" data-axis="{{key}}" style="{{theme}}"><div class="kaiju-axis-heading"><span class="kaiju-stage-icon"><i class="fa-solid fa-{{stage.icon}}" data-stage-icon aria-hidden="true"></i></span><div><h3>{{title}}</h3><p>{{description}}</p></div><div class="kaiju-number">{{#if ../isGM}}<input type="number" data-percent="{{key}}" min="0" max="100" step="1" value="{{value}}" aria-label="{{title}} em porcentagem">{{else}}<output class="kaiju-value" aria-label="{{title}}: {{value}}%">{{value}}</output>{{/if}}<span>%</span></div></div>
            {{#if ../isGM}}<input class="kaiju-range" type="range" data-range="{{key}}" min="0" max="100" step="1" value="{{value}}" aria-label="Ajustar {{title}}" style="--fill:{{value}}%">{{else}}<div class="kaiju-axis-meter" role="meter" aria-label="{{title}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{value}}" style="--fill:{{value}}%"></div>{{/if}}
            <div class="kaiju-stage-caption"><span>ESTÁGIO <b data-stage-roman>{{stage.roman}}</b></span><strong data-stage-label>{{stage.label}}</strong></div>
            <div class="kaiju-stage-markers" aria-hidden="true">{{#each markers}}<span class="{{#if current}}is-current{{/if}}" data-marker="{{index}}">{{roman}}</span>{{/each}}</div>
          </article>{{/each}}
        </section>

      </div>
      {{/if}}{{/if}}
      {{#if stages}}
      <div class="kaiju-stage-intro"><h2>Mapa de evolução</h2><p>Os seis estágios de cada eixo. O estágio VI começa em 100%.</p></div><div class="kaiju-stage-columns">{{#each axes}}<section class="kaiju-stage-column" data-stage-axis="{{key}}" tabindex="-1" style="{{theme}}"><h3>{{title}}</h3><ol>{{#each allStages}}<li style="{{theme}}" class="{{#if current}}is-current{{/if}} {{#if passed}}is-passed{{/if}}"><span class="kaiju-stage-node"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i></span><div><small>{{roman}} · {{range}}%</small><strong>{{label}}</strong>{{#if current}}<span class="kaiju-current-label">Estágio atual</span>{{/if}}</div></li>{{/each}}</ol></section>{{/each}}</div>
      {{/if}}
      {{#if notes}}
      <section class="kaiju-record-form"><h2>Registro do portador</h2><p>Identidade e anotações visíveis para quem pode acessar este vínculo.</p>{{#if isGM}}<label>Nome<input type="text" data-field="name" maxlength="120" value="{{carrier.name}}"></label><label>Designação<input type="text" data-field="designation" maxlength="120" value="{{carrier.designation}}" placeholder="Ex.: Piloto / Unidade 03"></label><fieldset class="kaiju-portrait-config"><legend>Retrato do portador</legend><label>Imagem (URL ou caminho do Foundry)<input type="text" data-field="portrait" value="{{carrier.portrait}}" placeholder="worlds/seu-mundo/retratos/lancer.webp"></label>{{#if canPickImage}}<button type="button" class="kaiju-button" data-command="pick-image"><i class="fa-solid fa-folder-open" aria-hidden="true"></i> Escolher imagem no Foundry</button>{{/if}}{{#if localImages}}<label class="kaiju-upload-label">Escolher imagem neste dispositivo<input type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-portrait-upload><small>Até 2 MB. A imagem permanece nesta demonstração.</small></label>{{/if}}<p>O scanner é um efeito visual sobre o retrato. Apague o caminho para remover a imagem.</p></fieldset><label>Anotações<textarea data-field="notes" maxlength="10000" rows="6" placeholder="Registre os acontecimentos do vínculo...">{{carrier.notes}}</textarea></label><label class="kaiju-share"><input type="checkbox" data-field="shared" {{#if carrier.shared}}checked{{/if}}><span><strong>Compartilhar com todos os jogadores</strong><small>Permite consultar o vínculo. A edição permanece com o mestre.</small></span></label>{{else}}<dl class="kaiju-record-details"><div><dt>Nome</dt><dd>{{carrier.name}}</dd></div><div><dt>Designação</dt><dd>{{#if carrier.designation}}{{carrier.designation}}{{else}}Sem designação.{{/if}}</dd></div><div><dt>Anotações</dt><dd class="kaiju-notes-text">{{#if carrier.notes}}{{carrier.notes}}{{else}}Nenhuma anotação compartilhada.{{/if}}</dd></div></dl>{{/if}}</section>
      {{/if}}
    </div>
    <footer class="kaiju-savebar"><span class="kaiju-status" role="status" aria-live="polite" data-status>{{#if dirty}}Alterações não salvas{{else}}{{#if isGM}}Registro atualizado{{else}}Consulta do vínculo{{/if}}{{/if}}</span>{{#if isGM}}<div><button type="button" class="kaiju-button kaiju-button-quiet" data-command="revert" {{#unless dirty}}disabled{{/unless}}>Descartar</button><button type="button" class="kaiju-button kaiju-button-primary" data-command="save" {{#unless dirty}}disabled{{/unless}}><i class="fa-solid fa-check" aria-hidden="true"></i>Salvar vínculo</button></div>{{/if}}</footer>
    {{else}}<div class="kaiju-empty"><i class="fa-solid fa-dragon" aria-hidden="true"></i><h1>{{#if isGM}}Seu primeiro vínculo{{else}}Nenhum vínculo disponível{{/if}}</h1><p>{{#if isGM}}Crie um portador para começar a acompanhar os três eixos.{{else}}O mestre pode compartilhar um vínculo para você consultar.{{/if}}</p>{{#if isGM}}<button type="button" class="kaiju-button kaiju-button-primary" data-command="new">Criar portador</button>{{/if}}</div>{{/if}}
  </main>
  {{#if isGM}}{{#if creating}}<div class="kaiju-dialog-backdrop"><form class="kaiju-create-form" role="dialog" aria-modal="true" aria-labelledby="{{instance}}-create-title"><span class="kaiju-eyebrow">NOVO VÍNCULO</span><h2 id="{{instance}}-create-title">Quem é o portador?</h2><label>Nome<input type="text" name="name" maxlength="120" required autofocus placeholder="Nome do portador"></label><p>Os três eixos começam em zero. O registro é restrito ao mestre.</p><div><button type="button" class="kaiju-button kaiju-button-quiet" data-command="cancel-create">Cancelar</button><button type="submit" class="kaiju-button kaiju-button-primary">Criar vínculo</button></div><span data-create-error role="alert"></span></form></div>{{/if}}{{/if}}
</section>
